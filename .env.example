# Copy to .env and edit. .env is ignored by git. Never commit a real key.

# ---------------------------------------------------------------------------
# Govee
# ---------------------------------------------------------------------------
# Official Govee developer API key. Requested in the Govee Home mobile app:
#   Profile > Settings > Apply for API Key
# Instructions: https://developer.govee.com/reference/apply-you-govee-api-key
# Read on the server only. It is never sent to the browser.
GOVEE_API_KEY=replace-with-your-govee-api-key

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
# 127.0.0.1 keeps the app on this computer. Use a LAN address or 0.0.0.0 only
# on a network you trust, and read docs/security.md first.
HOST=127.0.0.1
PORT=8787

# Host names browsers may use to reach the app (comma separated). Leave empty
# for the default: localhost names when bound to loopback, any host otherwise.
# Set it when you bind to a LAN address or sit behind a reverse proxy.
# ALLOWED_HOSTS=lights.home.arpa,192.168.1.20

# auto = Secure cookies whenever the request arrived over HTTPS.
# true = always (required behind an HTTPS reverse proxy unless TRUST_PROXY=true).
# false = never (only for plain HTTP on a trusted network).
COOKIE_SECURE=auto

# Set to true only when exactly one reverse proxy you control sits in front of the app.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# First-run setup
# ---------------------------------------------------------------------------
# Optional. Owner setup requires this code when set. If it is not set and others
# might reach the app (in Docker, off loopback, or behind a proxy), a one-time code
# is generated at startup and printed in the server log.
# SETUP_TOKEN=choose-a-long-random-value

# ---------------------------------------------------------------------------
# Storage and logging
# ---------------------------------------------------------------------------
# Relative paths resolve from the project root.
DATABASE_PATH=./data/govee-light-manager.sqlite
LOG_LEVEL=info
SESSION_TTL_HOURS=168

# ---------------------------------------------------------------------------
# Rate limits. These defaults sit below Govee's documented maxima; see
# docs/govee-integration.md. Raise them only if you have checked current limits.
# ---------------------------------------------------------------------------
# GOVEE_LIMIT_LIST_PER_MINUTE=20
# GOVEE_LIMIT_CONTROL_ACCOUNT_PER_SECOND=8
# GOVEE_LIMIT_CONTROL_DEVICE_PER_SECOND=1
# GOVEE_LIMIT_STATE_PER_MINUTE=20
# GOVEE_LIMIT_SCENES_PER_MINUTE=10
# GOVEE_DAILY_REQUEST_BUDGET=8000
# GOVEE_REQUEST_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Scheduler
# ---------------------------------------------------------------------------
# SCHEDULER_ENABLED=true
# A run this late still counts as on time. Later than this it is "missed".
# SCHEDULE_GRACE_SECONDS=120
# Oldest missed run the "run latest" policy will still recover.
# SCHEDULE_CATCHUP_MAX_HOURS=12
