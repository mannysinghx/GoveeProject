# Used only by `npm run dev:mock`. Points the app at the local mock instead of Govee.
# dev-mock-key is not a real credential.
GOVEE_API_KEY=dev-mock-key
GOVEE_API_BASE_URL=http://127.0.0.1:8788
DATABASE_PATH=./data/dev-mock.sqlite
PORT=8787

# The fake mail server from `npm run fake-smtp`, for trying sign-up and reset on this computer.
SMTP_HOST=127.0.0.1
SMTP_PORT=2525
SMTP_SECURITY=plain
MAIL_FROM=dev@lightup.test
PUBLIC_URL=http://localhost:5187
SIGNUP_POW_DIFFICULTY=12
